# 3. 데이터 받기
# ========================================

# recv()
# 지정한 바이트 수만큼 받음
data = p.recv(10)


# recvline()
# 한 줄을 받을 때까지 받음
data = p.recvline()


# recvuntil()
# 특정 문자열이 나올 때까지 받음
data = p.recvuntil(b"> ")


# recvlines()
# 여러 줄을 받음
data = p.recvlines(3)


# recvrepeat()
# 일정 시간 동안 계속 데이터 받기
data = p.recvrepeat(1)


# clean()
# 현재 남아 있는 데이터를 비움
p.clean()
