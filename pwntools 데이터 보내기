# ========================================
# 2. 데이터 보내기 (Sending Data)
# ========================================

# send()
# 데이터를 그대로 전송
p.send(b"hello")


# sendline()
# 데이터를 전송하고 마지막에 \n(엔터)을 붙임
p.sendline(b"hello")


# sendafter()
# 특정 문자열을 받을 때까지 기다린 후 데이터를 전송
p.sendafter(b"> ", b"hello")


# sendlineafter()
# 특정 문자열을 받을 때까지 기다린 후 데이터를 전송하고 \n을 붙임
p.sendlineafter(b"> ", b"hello")
